{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "rootDir": ".",
    "types": ["jest", "node"],
    "tsBuildInfoFile": "out-tsc/spec/tsconfig.spec.tsbuildinfo"
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/__tests__/**/*.ts",
    "src/testing/**/*.ts",
    "jest.setup.ts"
  ],
  "references": [{ "path": "./tsconfig.lib.json" }]
}
