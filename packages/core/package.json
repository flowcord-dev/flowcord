{
  "name": "@flowcord/core",
  "version": "0.1.0-alpha.2",
  "description": "Lifecycle-driven interactive menu framework for Discord.js",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./mocks": {
      "import": {
        "types": "./dist/esm/mocks/index.d.ts",
        "default": "./dist/esm/mocks/index.js"
      },
      "require": {
        "types": "./dist/cjs/mocks/index.d.ts",
        "default": "./dist/cjs/mocks/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "ARCHITECTURE.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "prepublishOnly": "nx build @flowcord/core",
    "flow:setup": "node scripts/setup-env.js",
    "flow": "tsx --env-file=.env examples/bot.ts"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flowcord-dev/flowcord.git"
  },
  "homepage": "https://github.com/flowcord-dev/flowcord#readme",
  "bugs": {
    "url": "https://github.com/flowcord-dev/flowcord/issues"
  },
  "author": "Nicholas Bely",
  "keywords": [
    "discord",
    "discord.js",
    "menu",
    "interaction",
    "framework",
    "flowcord"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "sideEffects": false,
  "peerDependencies": {
    "discord.js": "^14.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "discord.js": "^14.0.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.8.1",
    "ts-jest": "^29.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.4.0"
  }
}
